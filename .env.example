# O'Connors IMS RAG Chatbot — Environment Configuration
# Copy this to .env and fill in your values

# ChromaDB connection
# CHROMA_MODE=http  → remote Azure Container App (default)
# CHROMA_MODE=local → on-disk PersistentClient (offline dev)
CHROMA_MODE=http
CHROMADB_HOST=4.237.196.89
CHROMADB_PORT=8000
CHROMADB_SSL=false
CHROMADB_PATH=./chromadb_data
COLLECTION_NAME=oconnors_ims

# Embedding model (must match ingestion model)
EMBEDDING_MODEL=BAAI/bge-m3

# RAG retrieval parameters
# RETRIEVAL_K: how many chunks each retriever (vector + BM25) fetches
# TOP_K: how many chunks sent to the LLM after RRF fusion
RAG_RETRIEVAL_K=50
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.0

# LLM Provider
# LLM_PROVIDER=ollama        → self-hosted Ollama (default)
# LLM_PROVIDER=huggingface   → HuggingFace Inference API
# LLM_PROVIDER=azure-foundry → Azure AI Foundry serverless
LLM_PROVIDER=ollama

# Self-hosted Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_ENDPOINT=http://ollama-service:11434
LLM_MODEL=llama3.2:3b

# HuggingFace Inference API (used when LLM_PROVIDER=huggingface)
HUGGING_FACE_HUB_TOKEN=your_token_here
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_PROVIDER=featherless-ai

# Azure AI Foundry (used when LLM_PROVIDER=azure-foundry)
AZURE_FOUNDRY_ENDPOINT=https://<your-resource>.services.ai.azure.com/models
AZURE_FOUNDRY_KEY=your_azure_ai_key
AZURE_FOUNDRY_MODEL=Llama-3.1-8B-Instruct

# PostgreSQL — chat history source (chat_sessions.chat_history)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chatdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
