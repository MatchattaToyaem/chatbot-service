# O'Connors IMS RAG Chatbot — Environment Configuration
# Copy this to .env and fill in your values

# ChromaDB connection
# CHROMA_MODE=http  → remote Azure Container App (default)
# CHROMA_MODE=local → on-disk PersistentClient (offline dev)
CHROMA_MODE=http
CHROMADB_HOST=4.237.196.89
CHROMADB_PORT=8000
CHROMADB_SSL=false
CHROMADB_PATH=./chromadb_data
COLLECTION_NAME=oconnors_ims

# Embedding model (must match ingestion model)
EMBEDDING_MODEL=BAAI/bge-m3

# RAG retrieval parameters
# RETRIEVAL_K: how many chunks each retriever (vector + BM25) fetches
# TOP_K: how many chunks sent to the LLM after RRF fusion
RAG_RETRIEVAL_K=50
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.0

# LLM Provider
# LLM_PROVIDER=ollama       → self-hosted Ollama (default)
# LLM_PROVIDER=huggingface  → HuggingFace Inference API
LLM_PROVIDER=ollama

# Self-hosted Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_ENDPOINT=http://ollama-service:11434
LLM_MODEL=llama3.2:3b

# HuggingFace Inference API (used when LLM_PROVIDER=huggingface)
HUGGING_FACE_HUB_TOKEN=your_token_here
HF_MODEL=meta-llama/Llama-3.1-8B

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
