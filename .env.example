# O'Connors IMS RAG Chatbot — Environment Configuration
# Copy this to .env and fill in your values

# ChromaDB connection
# For Azure remote: set CHROMA_MODE=remote
# For local development/Colab: set CHROMA_MODE=local
CHROMA_MODE=local
CHROMA_HOST=chroma-db-ai-platform.proudground-90080d26.australiaeast.azurecontainerapps.io
CHROMA_PORT=443
CHROMA_SSL=true
CHROMA_COLLECTION=oconnors_ims_bge_m3
CHROMA_LOCAL_PATH=./chromadb_local

# Embedding model (must match ingestion model)
EMBEDDING_MODEL=BAAI/bge-m3

# RAG retrieval parameters
# RETRIEVAL_K: how many chunks each retriever (vector + BM25) fetches
# TOP_K: how many chunks sent to the LLM after RRF fusion
RAG_RETRIEVAL_K=50
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.0

# Ollama LLM
# llama3.1:8b recommended (follows complex prompt rules better than 3B)
# llama3.2 works but lower faithfulness on exact terminology
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
