# O'Connors IMS Chatbot Agent — Configuration Template
# Copy this file to .env and adjust values as needed.

# ChromaDB remote server (Mat's Azure Container Apps)
CHROMA_HOST=chroma-db-ai-platform.proudground-90080d26.australiaeast.azurecontainerapps.io
CHROMA_PORT=443
CHROMA_SSL=true
CHROMA_COLLECTION=oconnors_ims_bge_m3

# Embedding model (must match what was used during ingestion)
EMBEDDING_MODEL=BAAI/bge-m3

# RAG retrieval settings
RAG_RETRIEVAL_K=30
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.0

# Ollama LLM settings
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# FastAPI server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000